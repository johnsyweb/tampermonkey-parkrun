#!/bin/bash

# Pre-push: run CI (without live screenshot capture), then regenerate committed
# microsite screenshots only when src userscripts or the screenshot pipeline changed.

set -e

# Ensure aube from mise is on PATH (hooks run with minimal env)
export PATH="${MISE_DATA_DIR:-$HOME/.local/share/mise}/shims:$PATH"

# Skip in CI (GitHub Actions runs its own pipeline)
if [ "$CI" = "true" ] || [ "$GITHUB_ACTIONS" = "true" ]; then
  echo "⏭️  Skipping pre-push hooks in CI environment"
  exit 0
fi

echo "🔍 Running full CI (build, check, test, lint, docs:build)..."
if ! aube run ci; then
  echo ""
  echo "❌ CI failed. Fix the issues above before pushing."
  exit 1
fi
echo "✅ CI passed."
echo ""

PIPELINE_PATTERN='^(scripts/generate-screenshots\.ts|scripts/tsconfig\.json|scripts/generate-thumbnails\.js|\.husky/pre-push)$'
screenshots_ran=false

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    continue
  fi

  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    range="$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi

  pipeline_changed=$(git diff --name-only --diff-filter=ACMR "$range" | grep -E "$PIPELINE_PATTERN" || true)

  if [ -n "$pipeline_changed" ]; then
    echo "📸 Screenshot pipeline changed in commits being pushed:"
    echo "$pipeline_changed" | sed 's/^/  - /'
    echo ""
    echo "🔄 Regenerating all microsite screenshots..."
    if ! aube run screenshots -- --force; then
      echo ""
      echo "❌ Screenshot generation failed!"
      exit 1
    fi
    screenshots_ran=true
    break
  fi

  modified_src=$(git diff --name-only --diff-filter=ACMR "$range" | grep -E '^src/.*\.user\.js$' || true)

  if [ -n "$modified_src" ]; then
    echo "📸 Source userscripts changed in commits being pushed:"
    echo "$modified_src" | sed 's/^/  - /'
    echo ""
    while IFS= read -r file; do
      [ -z "$file" ] && continue
      script_name=$(basename "$file" .user.js)
      echo "🔄 Regenerating screenshot for ${script_name}..."
      if ! aube run screenshots -- "$script_name"; then
        echo ""
        echo "❌ Screenshot generation failed for ${script_name}!"
        exit 1
      fi
    done <<< "$modified_src"
    screenshots_ran=true
  fi
done

if [ "$screenshots_ran" = true ]; then
  echo ""
  echo "🖼️  Updating WebP thumbnails..."
  node scripts/generate-thumbnails.js
  echo ""

  if [ -n "$(git status --porcelain docs/images/)" ]; then
    echo "❌ Commit updated microsite screenshots before pushing."
    echo ""
    git status --short docs/images/
    echo ""
    echo "Stage and commit docs/images/, then push again."
    exit 1
  fi

  echo "✅ Microsite screenshots are up to date and committed."
fi

exit 0
