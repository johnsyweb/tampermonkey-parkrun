#!/bin/bash

# Pre-push: run CI (without live screenshot capture), then refresh committed
# microsite screenshots whose PNG or thumbnail predates its source userscript.

set -e

# Ensure aube from mise is on PATH (hooks run with minimal env)
export PATH="${MISE_DATA_DIR:-$HOME/.local/share/mise}/shims:$PATH"

# Skip in CI (GitHub Actions runs its own pipeline)
if [ "$CI" = "true" ] || [ "$GITHUB_ACTIONS" = "true" ]; then
  echo "⏭️  Skipping pre-push hooks in CI environment"
  exit 0
fi

echo "🔍 Running full CI (build, check, test, lint, docs:build)..."
if ! aube run ci; then
  echo ""
  echo "❌ CI failed. Fix the issues above before pushing."
  exit 1
fi
echo "✅ CI passed."
echo ""

stale_screenshots=$(node scripts/find-stale-screenshots.js)

if [ -n "$stale_screenshots" ]; then
  echo "📸 Microsite screenshots older than their source userscripts:"
  echo "$stale_screenshots" | sed 's/^/  - /'
  echo ""

  while IFS= read -r script_name; do
    [ -z "$script_name" ] && continue
    echo "🔄 Regenerating screenshot and thumbnail for ${script_name}..."
    if ! aube run screenshots -- "$script_name" --force; then
      echo ""
      echo "❌ Screenshot generation failed for ${script_name}!"
      exit 1
    fi
    node scripts/generate-thumbnails.js "$script_name"
  done <<< "$stale_screenshots"

  if [ -n "$(git status --porcelain docs/images/)" ]; then
    echo "❌ Commit updated microsite screenshots before pushing."
    echo ""
    git status --short docs/images/
    echo ""
    echo "Stage and commit docs/images/, then push again."
    exit 1
  fi

  echo "✅ Microsite screenshots are up to date and committed."
fi

exit 0
